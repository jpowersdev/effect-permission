{
  "extends": "./tsconfig.base.json",
  "include": [
    "src",
    "test",
    "typetest",
    "examples",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@jpowersdev/effect-permission": [
        "./src/index.ts"
      ],
      "@jpowersdev/effect-permission/*": [
        "./src/*.ts"
      ]
    }
  }
}
